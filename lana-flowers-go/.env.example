# Скопировать в .env и заполнить.

APP_PORT=8080

# Postgres DSN. Локально — Neon/Supabase free tier или docker postgres.
DATABASE_URL=postgres://user:pass@localhost:5432/lana_flowers?sslmode=disable

# Bot token из @BotFather — нужен для валидации Telegram WebApp initData (HMAC).
TELEGRAM_BOT_TOKEN=

# Произвольный секрет для server-to-server вызовов (например бот → API).
# Передаётся в заголовке X-Secret. Любая строка длиной 16+.
API_SECRET=
